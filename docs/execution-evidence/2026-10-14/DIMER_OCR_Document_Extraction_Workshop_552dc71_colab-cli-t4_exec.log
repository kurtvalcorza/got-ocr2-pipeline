             "cer":m["cer"],"wer":m["wer"],"token_precision":p,"token_recall":r 
 ,"token_f1":f,                                                                 
             "reference_chars":m["reference_chars"],"hypothesis_chars":m["hypot 
 hesis_chars"],                                                                 
